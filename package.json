{
  "name": "saas-boilerplate",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@app/api",
    "dev:web": "turbo run dev --filter=@app/web",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@app/api",
    "build:web": "turbo run build --filter=@app/web",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "db:generate": "npm run db:generate --workspace=apps/api",
    "db:push": "npm run db:push --workspace=apps/api",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:studio": "npm run db:studio --workspace=apps/api",
    "front:start": "bash scripts/devctl.sh front start",
    "front:stop": "bash scripts/devctl.sh front stop",
    "front:restart": "bash scripts/devctl.sh front restart",
    "front:status": "bash scripts/devctl.sh front status",
    "back:start": "bash scripts/devctl.sh back start",
    "back:stop": "bash scripts/devctl.sh back stop",
    "back:restart": "bash scripts/devctl.sh back restart",
    "back:status": "bash scripts/devctl.sh back status",
    "app:start": "bash scripts/devctl.sh app start",
    "app:stop": "bash scripts/devctl.sh app stop",
    "app:restart": "bash scripts/devctl.sh app restart",
    "app:status": "bash scripts/devctl.sh app status",
    "deploy": "bash deploy/deploy.sh"
  },
  "devDependencies": {
    "turbo": "^2"
  },
  "engines": {
    "node": ">=20"
  }
}
